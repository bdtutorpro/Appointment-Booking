rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if true; // Anyone can read for the admin dashboard demo (simplification, real product should use auth)
      allow create: if true; // Voice agent creates bookings
      allow update: if true; // For editing if needed
    }
  }
}
