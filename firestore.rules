rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read, create, update, delete: if true;
    }

    // Leads collection
    match /leads/{leadId} {
      allow read, create, update, delete: if true;
    }
  }
}
